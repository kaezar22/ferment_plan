# Copia este archivo a .streamlit/secrets.toml para pruebas locales.
# En Streamlit Community Cloud, pega este mismo contenido (con tus valores
# reales) en Settings -> Secrets de la app. Este archivo .example NO
# contiene secretos reales y sí se puede commitear; secrets.toml (sin
# .example) está en .gitignore y nunca debe subirse al repo.

# ID del Google Sheet (lo ves en la URL: .../d/ESTE_ID/edit)
SPREADSHEET_ID = "160F053a-MKrFQAet7MA28FDU6i5cJCiucM6-9XYiZ_M"

# Contenido del JSON de la cuenta de servicio de Google Cloud, como
# tabla TOML (copia cada campo del archivo service_account.json aquí).
[gcp_service_account]
type = "service_account"
project_id = "tu-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta@tu-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# Credenciales de Gmail, solo necesarias si quieres poder mandar el
# "correo de prueba" desde la propia app (el envío automático real lo
# hace GitHub Actions con sus propios secrets, ver README.md).
[gmail]
address = "tu-cuenta@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"
